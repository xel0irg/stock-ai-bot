# ============================================================
#  STOCK AI BOT — Environment Configuration
#  Copy this to .env and fill in your keys
# ============================================================

# --- Anthropic (Claude AI Engine) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Reddit API (https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockAIBot/1.0 by YourUsername

# --- StockTwits API ---
# Public endpoints work without auth; add token for higher rate limits
STOCKTWITS_ACCESS_TOKEN=optional_stocktwits_token

# --- Twitter/X API (https://developer.twitter.com) ---
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# --- Market Data ---
# yfinance is free/no key needed
# For options flow, we use public sources + scraping

# --- Bot Scan Settings ---
# Comma-separated list of tickers to monitor
WATCHLIST=AAPL,TSLA,NVDA,SPY,QQQ,AMZN,META,MSFT

# How often to run a full scan (in minutes)
SCAN_INTERVAL_MINUTES=15

# Minimum sentiment score to trigger alert (0.0 - 1.0)
SENTIMENT_THRESHOLD=0.6

# Minimum confluence score to generate a full AI analysis (0-100)
CONFLUENCE_THRESHOLD=65

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
